# ResumeIQ environment configuration
# Copy this file to `.env` and fill in your own keys. Never commit real keys.

# OpenAI API key (optional). If missing, ResumeIQ falls back to rule-based analysis
# and clearly labels AI-powered features as unavailable.
OPENAI_API_KEY=

# OpenAI model used for AI analysis & suggestions (optional override)
OPENAI_MODEL=gpt-4o-mini

# Optional: explicit OpenAI base URL (for compatible providers)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Database location (SQLite). Default: data/resumeiq.db
DATABASE_URL=sqlite:///data/resumeiq.db

# Maximum allowed upload size in MB
MAX_UPLOAD_MB=10

# Where generated PDF/DOCX resumes are written
GENERATED_DIR=generated_resumes

# Streamlit server port (used by run scripts)
APP_PORT=8501

# FastAPI: exact comma-separated browser origins. Empty disables cross-origin access.
# Set your real Vercel origin in the backend environment. Wildcards are rejected.
# Example: http://localhost:3000,https://your-frontend.vercel.app
API_ALLOWED_ORIGINS=

# Phase 2 cloud mode (optional; never required by Streamlit)
CLOUD_ENABLED=false
# Phase 4: AI requires this backend opt-in AND per-request user consent.
CLOUD_AI_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ALGORITHM=ES256
# API runtime: dedicated resumeiq_runtime (NOBYPASSRLS), never the admin role.
CLOUD_DATABASE_URL=postgresql+psycopg://resumeiq_runtime:password@localhost:5432/resumeiq
# Operator-only migrations/maintenance; omit from the deployed API environment.
CLOUD_MIGRATION_DATABASE_URL=postgresql+psycopg://migration_admin:password@localhost:5432/resumeiq
SUPABASE_STORAGE_BUCKET=resumes
# Backend-only modern sb_secret_ key; never a user JWT or publishable key.
SUPABASE_SECRET_KEY=

# Before public exposure, explicitly disable the legacy metadata-only upload.
API_PUBLIC_MODE=false
API_LEGACY_UPLOAD_ENABLED=true
# Live verification uses an explicit --allow-live-writes flag and dedicated users.
# PHASE2_API_URL=http://127.0.0.1:8000
# SUPABASE_PUBLISHABLE_KEY=
# PHASE2_TEST_USER_A_EMAIL=
# PHASE2_TEST_USER_B_EMAIL=
# Passwords are prompted securely; do not commit a test credential file.

# Phase 5 bounded PostgreSQL runtime pool (per process); no schema changes.
CLOUD_DB_POOL_SIZE=3
CLOUD_DB_MAX_OVERFLOW=1
CLOUD_DB_POOL_TIMEOUT=5
# Operator-only live verifier revision audit, READ ONLY; NEVER deploy in API/web.
# PHASE5_MIGRATION_AUDIT_DATABASE_URL=
# PHASE5_BROWSER_BASE_URL=http://127.0.0.1:3000
# PHASE5_API_URL=http://127.0.0.1:8000
# PHASE5_ALLOW_LIVE_WRITES=false
