# ResumeIQ environment configuration
# Copy this file to `.env` and fill in your own keys. Never commit real keys.

# OpenAI API key (optional). If missing, ResumeIQ falls back to rule-based analysis
# and clearly labels AI-powered features as unavailable.
OPENAI_API_KEY=

# OpenAI model used for AI analysis & suggestions (optional override)
OPENAI_MODEL=gpt-4o-mini

# Optional: explicit OpenAI base URL (for compatible providers)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Database location (SQLite). Default: data/resumeiq.db
DATABASE_URL=sqlite:///data/resumeiq.db

# Maximum allowed upload size in MB
MAX_UPLOAD_MB=10

# Where generated PDF/DOCX resumes are written
GENERATED_DIR=generated_resumes

# Streamlit server port (used by run scripts)
APP_PORT=8501

# FastAPI: exact comma-separated browser origins. Empty disables cross-origin access.
# Set your real Vercel origin in the backend environment. Wildcards are rejected.
# Example: http://localhost:3000,https://your-frontend.vercel.app
API_ALLOWED_ORIGINS=

# Phase 2 cloud mode (optional; never required by Streamlit)
CLOUD_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ALGORITHM=ES256
CLOUD_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resumeiq
SUPABASE_STORAGE_BUCKET=resumes
SUPABASE_SERVICE_ROLE_KEY=
